[Unit]
Description=PlasmaTop system stats daemon
Documentation=https://github.com/bogdan-d/plasma-top
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/plasma-top daemon
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
