# pacman scriptlet. The daemon is a systemd --user service, so it can't be
# enabled from these root-run hooks — they only print what the user must do.

post_install() {
	cat <<'EOF'
==> PiroStats is installed. Start it (per-user, NOT as root):
      systemctl --user enable --now pirostats
==> Then add the widget: right-click a panel -> Add Widgets -> "PiroStats".

==> The shipped config in /usr/lib/pirostats is read-only. To customize, copy a
    default into your XDG dir and edit that (first-that-exists wins):
      mkdir -p ~/.config/pirostats
      cp /usr/lib/pirostats/config/config.toml ~/.config/pirostats/
    Note: the config path is resolved at daemon startup, so the FIRST time you
    create ~/.config/pirostats/config.toml, restart to pick it up:
      systemctl --user restart pirostats
    Editing an already-present XDG config/style hot-reloads, no restart needed.

==> Optional features pull in optdepends (NVIDIA GPU, ss connections, fastfetch,
    Bolt HID batteries) — see `pacman -Qi pirostats-git`.
EOF
}

post_upgrade() {
	cat <<'EOF'
==> PiroStats upgraded. Reload the running daemon to pick up new code:
      systemctl --user restart pirostats
==> If the applet changed and the panel looks stale, restart the shell:
      systemctl --user restart plasma-plasmashell   # or: kquitapp6 plasmashell && kstart plasmashell
EOF
}

pre_remove() {
	cat <<'EOF'
==> Stop and disable the PiroStats daemon before removal (per-user):
      systemctl --user disable --now pirostats
==> Remove the widget from your panel if it's still there. Your config in
    ~/.config/pirostats is left untouched; delete it by hand if you want it gone.
EOF
}
