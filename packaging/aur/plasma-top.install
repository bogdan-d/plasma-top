# shellcheck shell=bash
# Pacman sources this scriptlet; the daemon is a systemd --user service, so root-run hooks only print what the user must do.

post_install() {
	cat <<'EOF'
==> PlasmaTop is installed. Start it (per-user, NOT as root):
      systemctl --user enable --now plasma-top
==> Then add the widget: right-click a panel -> Add Widgets -> "PlasmaTop".

==> The shipped config in /usr/lib/plasma-top is read-only. To customize, copy a default into your XDG dir and edit that (first-that-exists wins):
      mkdir -p ~/.config/plasma-top
      cp /usr/lib/plasma-top/config/config.toml ~/.config/plasma-top/
    Creating or editing an XDG config/style hot-reloads through inotify, no restart needed.

==> Optional tools provide NVIDIA, network/Wi-Fi, and fastfetch data — see `pacman -Qi plasma-top-git`.
EOF
}

post_upgrade() {
	cat <<'EOF'
==> PlasmaTop upgraded. Log out and back in before using it.
==> The daemon and loaded applet use a matched visibility protocol. Do not restart only plasma-top or only plasmashell; the login restart activates both new versions together.
EOF
}

pre_remove() {
	cat <<'EOF'
==> Stop and disable the PlasmaTop daemon before removal (per-user):
      systemctl --user disable --now plasma-top
==> Remove the widget from your panel if it's still there. Your config in ~/.config/plasma-top is left untouched; delete it by hand if you want it gone.
EOF
}
