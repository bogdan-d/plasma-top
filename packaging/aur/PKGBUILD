# Maintainer: Luca Forina <lucazade80@gmail.com>
pkgname=pirostats-git
_reponame=pirostats
pkgver=0
pkgrel=1
pkgdesc="System stats in the KDE Plasma panel and a paginated tooltip"
arch=('x86_64')
url="https://github.com/lucazade/pirostats"
license=('GPL-2.0-or-later')
depends=('plasma-workspace')
optdepends=('nvidia-utils: NVIDIA GPU metrics through NVML or nvidia-smi'
            'iproute2: network identity and the connections tooltip page'
            'iw: Wi-Fi SSID and signal'
            'fastfetch: the fastfetch tooltip page')
makedepends=('cargo' 'git')
provides=('pirostats')
conflicts=('pirostats')
source=("git+https://github.com/lucazade/pirostats.git")
sha256sums=('SKIP')
install="$_reponame.install"

pkgver() {
	cd "$srcdir/$_reponame"
	# A pipeline would hide an untagged git-describe failure under sed's success.
	local desc
	if desc=$(git describe --long --tags 2>/dev/null); then
		printf '%s' "$desc" | sed 's/^v//; s/\([^-]*-g\)/r\1/; s/-/./g'
	else
		printf 'r%s.%s' "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
	fi
}

build() {
	cd "$srcdir/$_reponame"
	CARGO_TARGET_DIR=rust/target \
		cargo build --manifest-path rust/Cargo.toml --release --locked --features nvml
}

package() {
	cd "$srcdir/$_reponame"
	local libdir="$pkgdir/usr/lib/pirostats"
	local appletid="com.github.lucazade.pirostats"

	install -d "$libdir"
	cp -r style lang config "$libdir/"
	install -m755 rust/target/release/pirostats "$libdir/pirostats"
	install -Dm755 packaging/pirostats-launcher "$pkgdir/usr/bin/pirostats"
	install -Dm644 service/pirostats.service "$pkgdir/usr/lib/systemd/user/pirostats.service"
	install -Dm644 plasmoid/package/contents/icons/pirostats.svg \
		"$pkgdir/usr/share/icons/hicolor/scalable/apps/pirostats.svg"

	install -d "$pkgdir/usr/share/plasma/plasmoids/$appletid"
	cp -r plasmoid/package/. "$pkgdir/usr/share/plasma/plasmoids/$appletid/"

	install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
	install -Dm644 NOTICE "$pkgdir/usr/share/licenses/$pkgname/NOTICE"
}
