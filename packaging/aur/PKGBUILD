# Maintainer: BogdanD
pkgname=plasma-top-git
_reponame=plasma-top
pkgver=0
pkgrel=1
pkgdesc="System stats in the KDE Plasma panel and a paginated tooltip"
arch=('x86_64')
url="https://github.com/bogdan-d/plasma-top"
license=('GPL-2.0-or-later')
depends=('plasma-workspace')
optdepends=('nvidia-utils: NVIDIA GPU metrics through NVML or nvidia-smi'
            'iproute2: network identity and the connections tooltip page'
            'iw: Wi-Fi SSID and signal'
            'fastfetch: the fastfetch tooltip page')
makedepends=('cargo' 'git')
provides=('plasma-top')
conflicts=('plasma-top')
source=("git+https://github.com/bogdan-d/plasma-top.git")
sha256sums=('SKIP')
install="$_reponame.install"

pkgver() {
	cd "$srcdir/$_reponame"
	# A pipeline would hide an untagged git-describe failure under sed's success.
	local desc
	if desc=$(git describe --long --tags 2>/dev/null); then
		printf '%s' "$desc" | sed 's/^v//; s/\([^-]*-g\)/r\1/; s/-/./g'
	else
		printf 'r%s.%s' "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
	fi
}

build() {
	cd "$srcdir/$_reponame"
	CARGO_TARGET_DIR=rust/target \
		cargo build --manifest-path rust/Cargo.toml --release --locked --features nvml
}

package() {
	cd "$srcdir/$_reponame"
	local libdir="$pkgdir/usr/lib/plasma-top"
	local appletid="com.github.bogdan-d.plasma-top"

	install -d "$libdir"
	cp -r style lang config "$libdir/"
	install -m755 rust/target/release/plasma-top "$libdir/plasma-top"
	install -Dm755 packaging/plasma-top-launcher "$pkgdir/usr/bin/plasma-top"
	install -Dm644 service/plasma-top.service "$pkgdir/usr/lib/systemd/user/plasma-top.service"
	install -Dm644 plasmoid/package/contents/icons/plasma-top.svg \
		"$pkgdir/usr/share/icons/hicolor/scalable/apps/plasma-top.svg"

	install -d "$pkgdir/usr/share/plasma/plasmoids/$appletid"
	cp -r plasmoid/package/. "$pkgdir/usr/share/plasma/plasmoids/$appletid/"

	install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
	install -Dm644 NOTICE "$pkgdir/usr/share/licenses/$pkgname/NOTICE"
}
