# EditorConfig is awesome: http://EditorConfig.org

# top-most EditorConfig file
root = true

# Unix-style newlines with a newline ending every file
[*]
charset = utf-8
end_of_line = lf
indent_size = 2
indent_style = tab
insert_final_newline = false
tab_width = 2
trim_trailing_whitespace = true
quote_type = single

[*.{yml,yaml,py}]
insert_final_newline = true
indent_style = space
indent_size = 4
tab_width = 4

[*.[Mm][Dd]]
insert_final_newline = true

[*.eslintrc*]
insert_final_newline = true

[Makefile]
indent_style = tab

[*.{php,json,jsonc,html}]
quote_type = double

[*.{rs,toml}]
indent_style = space
indent_size = 4
tab_width = 4
quote_type = double

[*.xml]
trim_trailing_whitespace = false
quote_type = double

# Dockerfiles, shell scripts, confs & ini
[*.{sh,bash,zsh,conf,ini}]
insert_final_newline = true
indent_style = space
indent_size = 4
tab_width = 4
# shfmt: parse shell as bash regardless of shebang
shell_variant = bash

[Dockerfile*]
insert_final_newline = true
indent_style = space
indent_size = 4
tab_width = 4

# Shell scripts
[*.{sh,bash,zsh,[Bb][Aa][Tt],[Cc][Mm][Dd]}]
trim_trailing_whitespace = false

# shell scripts with no extension
[!.]
trim_trailing_whitespace = false
insert_final_newline = true
indent_style = space
indent_size = 4
tab_width = 4

[plasma-top]
trim_trailing_whitespace = false
insert_final_newline = true
indent_style = space
indent_size = 4
tab_width = 4

# Windows bat/cmd scripts
[*.{[Bb][Aa][Tt],[Cc][Mm][Dd]}]
# DOS/Win *requires* BAT/CMD files to have CRLF newlines
end_of_line = crlf
insert_final_newline = true
